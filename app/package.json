{
  "name": "photobooth-kiosk",
  "productName": "Xinhmo Booth",
  "version": "1.0.0",
  "description": "Offline self-service photobooth kiosk",
  "main": "main.js",
  "author": "Xinhmo",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "mock": "PB_MOCK_CAMERA=1 PB_PRINT_DRYRUN=1 PB_KIOSK=0 electron .",
    "windowed": "PB_KIOSK=0 electron .",
    "check": "node scripts/selftest.js",
    "dist": "electron-builder --mac --dir",
    "pack": "electron-builder --mac",
    "mock-kiosk": "PB_MOCK_CAMERA=1 PB_PRINT_DRYRUN=1 electron .",
    "dev": "PB_PRINT_DRYRUN=1 PB_KIOSK=0 electron .",
    "build:camera": "bash scripts/build-camera-helper.sh",
    "docs": "electron scripts/build-docs.js"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "marked": "^14.1.4"
  },
  "build": {
    "appId": "com.xinhmo.kiosk",
    "productName": "Xinhmo Booth",
    "files": [
      "**/*",
      "!sessions/**",
      "!logs/**",
      "!dist/**"
    ],
    "extraResources": [
      {
        "from": "frames",
        "to": "frames"
      }
    ],
    "mac": {
      "category": "public.app-category.photography",
      "target": [
        "dir"
      ],
      "extendInfo": {
        "NSCameraUsageDescription": "The booth uses the built-in camera when no DSLR is connected.",
        "NSMicrophoneUsageDescription": "Not used."
      }
    }
  }
}
